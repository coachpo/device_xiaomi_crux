# crux-install/1 Dev OTA helper services for CruxUpdater.
on post-fs-data
    mkdir /data/ota_package/crux 0770 system system
    mkdir /metadata/crux_ota 0700 root root

# Map the downloaded assets for PE Recovery and write the U-Boot request.
# The groups reach /data/ota_package (system:cache 0770) and the app's
# downloads (system 0770) without DAC override.
service crux_ota_prepare /system/bin/crux-installer --a-service prepare
    user root
    group root system cache
    disabled
    oneshot
    seclabel u:r:crux_ota:s0

# Report the last update to CruxUpdater and retire it once U-Boot finished it.
service crux_ota_result /system/bin/crux-installer --a-service result
    user root
    group root system cache
    disabled
    oneshot
    seclabel u:r:crux_ota:s0

on property:sys.crux_ota.request=prepare
    start crux_ota_prepare

on property:sys.boot_completed=1
    start crux_ota_result
