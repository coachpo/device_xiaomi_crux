// Crux PE13 Dev OTA updater: Settings > System > Additional system updates.
// Checks the signed crux-ota/1 Dev channel, downloads and verifies the assets,
// has the crux_ota_prepare init service map them, and reboots to recovery.
android_app {
    name: "CruxUpdater",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-cruxupdater.xml"],
}

// ro.control_privapp_permissions=enforce: without this allowlist system_server
// refuses to boot when a privileged app requests REBOOT or RECOVERY.
prebuilt_etc {
    name: "privapp-permissions-cruxupdater.xml",
    src: "privapp-permissions-cruxupdater.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
