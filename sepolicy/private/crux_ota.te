# crux-install/1 Dev OTA helper (crux-installer --a-service) started by init for CruxUpdater.
type crux_ota, domain, coredomain;
type crux_ota_exec, system_file_type, exec_type, file_type;
init_daemon_domain(crux_ota)

allow crux_ota system_data_file:dir search;
allow crux_ota ota_package_file:dir create_dir_perms;
allow crux_ota ota_package_file:file create_file_perms;
allowxperm crux_ota ota_package_file:file ioctl FS_IOC_FIEMAP;
allow crux_ota block_device:dir search;
allow crux_ota block_device:lnk_file read;
allow crux_ota userdata_block_device:blk_file rw_file_perms;
allow crux_ota system_block_device:blk_file r_file_perms;
allow crux_ota metadata_file:dir search;
allow crux_ota ota_metadata_file:dir create_dir_perms;
allow crux_ota ota_metadata_file:file create_file_perms;
allow crux_ota proc_cmdline:file r_file_perms;

# PE Recovery runs the recovery variant of the same binary from its ramdisk
# (rootfs, already executable). Before writing it asks each partition for its
# read-only flag and extent; coredomain may not read unlabeled sysfs.
allowxperm recovery dev_type:blk_file ioctl { BLKROGET BLKGETSIZE64 HDIO_GETGEO };
