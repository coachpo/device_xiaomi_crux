service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.3-service.crux
    class late_start
    user system
    group system input uhid

on boot
    chown system system /sys/class/drm/card0-DSI-1/dim_layer_enable
    chmod 0660 /sys/class/drm/card0-DSI-1/dim_layer_enable

on post-fs-data
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
