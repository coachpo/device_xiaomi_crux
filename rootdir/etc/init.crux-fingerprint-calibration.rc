# qseecomd drops to system before its filesystem listener opens calibration.
# Keep the stock root owner and modes; the existing group read bit is enough.
on post-fs-data
    chown root system /mnt/vendor/persist/goodix/cali_data.so
    chown root system /mnt/vendor/persist/goodix/caliParamsInfo.so
    chown root system /mnt/vendor/persist/goodix/BMatrix.so
    chown root system /mnt/vendor/persist/goodix/chartbase.so
